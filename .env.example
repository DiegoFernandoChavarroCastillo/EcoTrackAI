# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore: nunca subas claves reales al repositorio.

# Clave de la API de Groq (https://console.groq.com/keys).
# Solo se usa en el servidor (app/api/analyze). No la prefijes con NEXT_PUBLIC_.
# En Vercel: Project Settings -> Environment Variables.
GROQ_API_KEY=

# Modelo de Groq a usar. Opcional: si no se define, el código usa
# openai/gpt-oss-120b, que soporta salida JSON estricta.
# Groq retira modelos sin aviso: si el endpoint empieza a devolver 502, revisa
# https://console.groq.com/docs/models y pon aquí uno vigente.
GROQ_MODEL=

# Opcional. Solo para pruebas locales o un proxy: apunta las llamadas a otro
# host compatible con la API de OpenAI. Si se deja vacío, se usa api.groq.com.
GROQ_BASE_URL=
